{
  "name": "webgeneralsonline-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser shell for WebGeneralsOnline: password gate, game file download and update, engine launch.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "mock": "node test/mock-server.mjs"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
