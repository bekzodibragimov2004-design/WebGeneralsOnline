# Copy to .env at the repo root and fill in. .env is git-ignored and must never be committed.
GAME_DIR=            # Steam install of C&C Generals + Zero Hour on this laptop
SITE_PASSWORD=       # single shared password for the web app

# GO has no username and password login. Sign in by hand through Steam, Discord or
# GameReplays on GO's website, and don't put those passwords here. See docs/NETWORK.md.
